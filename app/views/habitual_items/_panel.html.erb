<div id="habitual_items">
  <details <%= "open" if local_assigns[:open] %> class="group rounded-2xl border border-line bg-surface">
    <summary class="flex cursor-pointer list-none items-center justify-between px-4 py-3 text-sm font-medium text-ink-soft">
      <span>Habituais</span>
      <span aria-hidden="true" class="text-xs text-ink-faint transition-transform group-open:rotate-180">⌄</span>
    </summary>
    <div class="space-y-3 border-t border-line px-4 py-3">
      <%= render "habitual_items/form", habitual_item: habitual_item, message: local_assigns[:message] %>
      <%= render "habitual_items/list", household: household %>
    </div>
  </details>
</div>
