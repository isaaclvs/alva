<div id="list_items" class="space-y-6 px-4 py-4">
  <% if groups.empty? %>
    <p class="py-12 text-center text-stone-500">Lista vazia. Adicione o primeiro item acima.</p>
  <% end %>

  <% groups.each do |category, items| %>
    <section id="<%= category ? dom_id(category) : "uncategorized" %>">
      <h2 class="mb-2 text-xs font-semibold uppercase tracking-wide text-teal-700">
        <%= category&.name || "Sem categoria" %>
      </h2>
      <ul class="divide-y divide-stone-200 rounded-lg border border-stone-200 bg-white">
        <%= render partial: "list_items/list_item", collection: items %>
      </ul>
    </section>
  <% end %>

  <% purchased_count = groups.sum { |_, items| items.count(&:purchased?) } %>
  <% if purchased_count.positive? %>
    <%= button_to "Limpar comprados", clear_purchased_list_items_path, method: :delete,
          form: { data: { turbo_confirm: "Remover #{pluralize(purchased_count, "item comprado", plural: "itens comprados")} da lista?" } },
          class: "w-full rounded-lg border border-stone-300 bg-white px-4 py-3 font-medium text-stone-700 active:bg-stone-100" %>
  <% end %>
</div>
