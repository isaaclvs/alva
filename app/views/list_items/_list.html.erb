<div id="list_items" class="shopping-categories space-y-5 px-4 pt-2">
  <% if groups.empty? %>
    <div class="list-empty py-16 text-center">
      <p class="text-4xl" aria-hidden="true">🛒</p>
      <p class="mt-3 text-ink-soft">Nada na lista por enquanto.</p>
      <p class="shopping-only mt-1 text-sm text-ink-faint">Toque em Sair das compras para voltar.</p>
      <button type="button" class="shopping-hide mt-3 text-sm font-semibold text-accent-strong underline underline-offset-4"
              data-action="screen#show" data-screen-screen-param="add">Adicionar itens</button>
    </div>
  <% end %>

  <% groups.each do |category, items| %>
    <%= render "list_items/category", category: category, items: items %>
  <% end %>

  <%= render "list_items/finish", groups: groups %>
</div>
