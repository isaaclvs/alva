<%= render "refresh", groups: @groups, suggestions: @suggestions, household: current_household %>
<%= turbo_stream.replace "list_item_form", partial: "form", locals: { list_item: ListItem.new } %>
<%= @feedback %>
<%= turbo_stream.prepend "recent_adds_list", partial: "recent_item", collection: [ @added_item ].compact, as: :item %>
<% if @revived_item %>
  <%= turbo_stream.replace @revived_item, partial: "list_item", locals: { list_item: @revived_item, highlight: true } %>
<% end %>
