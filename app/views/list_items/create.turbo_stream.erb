<%= render "refresh", groups: @groups, suggestions: @suggestions, household: current_household %>
<%= turbo_stream.replace "list_item_form", partial: "form", locals: { list_item: ListItem.new } %>
<%= @feedback %>
<%# Only a name this add created can be taken back on the spot; a revived one
    is a bought item that came back, and removing it would delete history. %>
<% if @added_item %>
  <%= turbo_stream.prepend "recent_adds_list", partial: "recent_item", locals: { item: @added_item, undoable: @added_outcome == :created } %>
<% end %>
<% if @revived_item %>
  <%= turbo_stream.replace @revived_item, partial: "list_item", locals: { list_item: @revived_item, highlight: true } %>
<% end %>
