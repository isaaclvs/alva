<%# Always rendered, so live updates have a target to fill; empty when there is
    nothing to suggest. Only a few shortcuts: the field is the main way in.
    A suggestion whose median interval already passed since its last purchase
    (#163) comes first and, right under its chip, carries a quiet "costuma
    acabar a cada ~12 dias" plus "Agora não": that hides the suggestion on this
    device for a few days (buy_again_controller.js, localStorage, never
    broadcast). The chip keeps the size and shape of the others. %>
<div id="buy_again" data-controller="buy-again">
  <% if suggestions.any? %>
    <div role="group" aria-labelledby="buy_again_title">
      <h2 id="buy_again_title" class="mb-2 text-xs font-medium tracking-wider text-ink-soft">Comprar de novo</h2>
      <div class="flex flex-wrap items-start gap-2">
        <% suggestions.each do |suggestion| %>
          <%= tag.div class: "flex flex-col items-start", data: { buy_again_suggestion: suggestion.name } do %>
            <%= button_to list_items_path, params: { list_item: { name: suggestion.name } }, form: { class: "contents" },
                  class: "flex min-h-[var(--size-touch)] items-center gap-1.5 rounded-full border border-line bg-surface py-2 pr-3 pl-3 text-xs text-ink active:bg-surface-2" do %>
              <span class="text-accent" aria-hidden="true">+</span>
              <%= suggestion.name %>
            <% end %>
            <% if suggestion.due? %>
              <span class="mt-1 text-[11px] leading-tight text-ink-faint"><%= buy_again_cadence(suggestion) %></span>
              <button type="button" class="min-h-[var(--size-touch)] text-[11px] text-ink-faint underline underline-offset-2 active:text-ink"
                      data-action="buy-again#dismiss" data-buy-again-dismiss="<%= suggestion.name %>">Agora não</button>
            <% end %>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
