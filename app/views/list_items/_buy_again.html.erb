<%# Always rendered, so live updates have a target to fill; empty when there is
    nothing to suggest. Only a few shortcuts: the field is the main way in. %>
<div id="buy_again">
  <% if suggestions.any? %>
    <div role="group" aria-labelledby="buy_again_title">
      <h2 id="buy_again_title" class="mb-2 text-sm font-medium text-ink-soft">Comprar de novo</h2>
      <div class="flex flex-wrap gap-2">
        <% suggestions.each do |suggestion| %>
          <%= button_to list_items_path, params: { list_item: { name: suggestion.name } }, form: { class: "contents" },
                class: "flex items-center gap-1.5 rounded-full border border-line bg-surface py-1 pr-3 pl-1 text-sm text-ink active:bg-surface-2" do %>
            <%= category_icon(suggestion.category) %>
            <%= suggestion.name %>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
