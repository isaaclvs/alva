<% items = groups.flat_map(&:last) %>
<% purchased_count = items.count(&:purchased?) %>
<div id="list_summary" class="mb-3">
  <div class="flex items-center justify-between gap-3">
    <h1 class="text-2xl font-bold tracking-tight">Lista</h1>
    <div class="flex items-center gap-1">
      <p class="mr-1 text-sm text-zinc-400"><%= list_summary_text(items.size - purchased_count, purchased_count) %></p>
      <%= link_to list_export_path, title: "Baixar PDF", aria: { label: "Baixar PDF" }, download: true, data: { turbo: false },
            class: "grid size-9 shrink-0 place-items-center rounded-full text-zinc-400 active:bg-zinc-800" do %>
        <svg class="size-5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M10 3v9m0 0-3.5-3.5M10 12l3.5-3.5M4 14v1.5A1.5 1.5 0 0 0 5.5 17h9a1.5 1.5 0 0 0 1.5-1.5V14" />
        </svg>
      <% end %>
      <%= render "list_items/theme_toggle" %>
    </div>
  </div>
  <%= tag.div class: "mt-3 h-1 overflow-hidden rounded-full bg-zinc-800", role: "progressbar",
        aria: { label: "Itens no carrinho", valuemin: 0, valuemax: items.size, valuenow: purchased_count } do %>
    <div class="h-full rounded-full bg-gradient-to-r from-emerald-400 to-teal-400 transition-[width] duration-300"
         style="width: <%= items.empty? ? 0 : purchased_count * 100 / items.size %>%"></div>
  <% end %>
</div>
