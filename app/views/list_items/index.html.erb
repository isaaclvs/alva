<%= turbo_stream_from @household %>

<%= tag.div data: { controller: "list-refresh", list_refresh_url_value: root_path } do %>
  <header class="sticky top-0 z-10 bg-zinc-950/90 px-4 pt-5 pb-3 backdrop-blur">
    <%= render "summary", groups: @groups %>
    <%= render "form", list_item: @list_item %>
    <%= render "buy_again", suggestions: @suggestions %>
    <div id="list_refresh_status" hidden role="status" aria-live="polite"
         class="mt-2 flex items-center justify-between gap-3 rounded-xl border border-zinc-800 bg-zinc-900/90 px-3 py-2 text-xs text-zinc-400"
         data-list-refresh-target="status">
      <span data-list-refresh-target="message"></span>
      <button type="button" class="shrink-0 font-medium text-teal-300 underline underline-offset-2"
              data-list-refresh-target="retry" data-action="list-refresh#retry" hidden>
        Tentar novamente
      </button>
    </div>
  </header>

  <%= render "list", groups: @groups %>
<% end %>

<%# Filled by turbo_stream.update in the response to a remove or "Compra feita"
    (see _toast); fixed above the safe area at the bottom of the screen. %>
<div id="toast" class="pointer-events-none fixed inset-x-0 bottom-0 z-20 mx-auto flex max-w-md justify-center px-4 pb-[calc(env(safe-area-inset-bottom)+1rem)]"></div>
