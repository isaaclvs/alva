<%= turbo_stream_from @household %>

<%# Two spaces on one page: Adicionar (the start) and Lista. Which one is open
    is local to this device (screen_controller.js + the "screen" cookie), so
    broadcasts only ever touch what is inside them, never the navigation. %>
<% screen = current_screen %>
<%= tag.div data: { controller: "list-refresh screen shopping", list_refresh_url_value: root_path, screen_current_value: screen } do %>
  <div id="list_refresh_status" hidden role="status" aria-live="polite"
       class="sticky top-0 z-20 mx-4 mt-3 flex items-center justify-between gap-3 rounded-xl border border-line bg-surface px-3 py-2 text-xs text-ink-soft"
       data-list-refresh-target="status">
    <span data-list-refresh-target="message"></span>
    <button type="button" class="shrink-0 font-medium text-accent-strong underline underline-offset-2"
            data-list-refresh-target="retry" data-action="list-refresh#retry" hidden>
      Tentar novamente
    </button>
  </div>

  <%# Adicionar: on phones the field sits at the bottom, next to the thumb and
      the keyboard; what was just added shows above it with its category. %>
  <section id="add_screen" aria-labelledby="add_screen_title" class="add-screen flex flex-col px-5 pt-5 pb-24"
           data-screen-target="panel" data-screen-name="add" <%= "hidden" unless screen == "add" %>>
    <header class="flex items-center justify-between gap-3">
      <div class="flex items-center gap-2.5">
        <span class="grid size-9 place-items-center text-accent" aria-hidden="true"><%= render "brand_mark", css_class: "size-7" %></span>
        <div class="leading-tight">
          <p class="text-sm font-semibold">Alva</p>
          <p class="text-xs text-ink-faint">Nossa casa</p>
        </div>
      </div>
      <%= render "list_items/menu" %>
    </header>

    <%# Filled by the add responses (never by broadcasts), like #add_feedback. %>
    <div id="recent_adds" class="mt-6"></div>

    <div class="add-screen-content mt-auto pt-6">
      <h1 id="add_screen_title" class="text-2xl font-semibold tracking-tight">O que está faltando em casa?</h1>
      <p class="mt-0.5 text-sm text-ink-soft">Lembrou, adicionou.</p>

      <div class="mt-4">
        <%= render "buy_again", suggestions: @suggestions %>
      </div>

      <div class="mt-3">
        <%= render "form", list_item: @list_item, autofocus: screen == "add" %>
        <p id="add_hint" class="mt-2 px-1 text-xs text-ink-faint">Separe por vírgula para adicionar vários.</p>
        <%# Filled by the add responses (never by broadcasts): only this device
            hears what it just added. %>
        <p id="add_feedback" role="status" aria-live="polite" class="mt-1 min-h-5 px-1 text-sm font-medium"></p>
      </div>

      <div class="mt-2">
        <%= render "habitual_items/panel", household: @household, habitual_item: @habitual_item %>
      </div>
    </div>
  </section>

  <section id="list_screen" aria-labelledby="list_screen_title" class="shopping-screen pb-28" data-controller="list-filter" data-action="shopping:exited@window->list-filter#reset"
           data-screen-target="panel" data-screen-name="list" <%= "hidden" unless screen == "list" %>>
    <header class="list-screen-header sticky top-0 z-10 bg-canvas px-4 pt-5 pb-3">
      <div class="list-brand-row mb-5 flex items-center gap-2.5">
        <span class="text-accent" aria-hidden="true"><%= render "brand_mark", css_class: "size-8" %></span>
        <div class="leading-tight"><p class="text-sm font-semibold">Alva</p><p class="mt-0.5 text-xs text-ink-faint">Nossa casa</p></div>
          <button type="button" class="shopping-only ml-auto min-h-11 shrink-0 rounded-full border border-line px-4 text-sm font-semibold text-ink-soft active:bg-surface-2"
                  data-action="shopping#exit">Sair das compras</button>
      </div>
      <div class="flex items-center justify-between gap-2">
        <h1 id="list_screen_title" tabindex="-1" class="shopping-hide text-2xl font-semibold tracking-tight">Lista de compras</h1>
        <h1 id="shopping_title" tabindex="-1" class="shopping-only text-2xl font-semibold tracking-tight" data-shopping-target="title">Em compras</h1>
        <div class="flex items-center gap-1">
          <button type="button" title="Buscar" aria-label="Buscar" aria-controls="list_search_panel" aria-expanded="true"
                  class="grid size-10 shrink-0 place-items-center rounded-full text-ink-soft active:bg-surface-2 aria-expanded:bg-surface-2 aria-expanded:text-ink"
                  data-list-filter-target="toggle" data-action="list-filter#toggle">
            <svg class="size-5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
              <circle cx="9" cy="9" r="5.25" /><path d="m13 13 4 4" />
            </svg>
          </button>
          <%= render "list_items/menu", pdf: true %>

        </div>
      </div>
      <%= render "summary", groups: @groups %>
      <div id="list_search_panel" data-list-filter-target="panel" class="mt-3 flex flex-col items-stretch gap-3">
        <div class="relative min-w-0 flex-1">
          <label for="list_search" class="sr-only">Buscar na lista</label>
          <input id="list_search" type="search" placeholder="Buscar na lista" autocomplete="off"
                 class="min-h-11 w-full rounded-xl border border-line bg-surface py-2 pr-12 pl-3 text-base text-ink"
                 data-list-filter-target="query" data-action="input->list-filter#apply">
          <button type="button" aria-label="Limpar busca" title="Limpar busca" hidden data-list-filter-target="clear"
                  data-action="list-filter#clear" class="absolute inset-y-0 right-0 w-11 text-ink-soft">×</button>
        </div>
        <div class="list-filter-options flex items-center justify-between gap-3"><label class="flex min-h-11 shrink-0 items-center gap-2 text-sm text-ink-soft">
          <input type="checkbox" data-list-filter-target="pending" data-action="change->list-filter#apply" class="size-4 accent-accent">
          Só pendentes
        </label><span class="text-xs text-ink-faint">Seções · A–Z</span></div>
      </div>
    </header>

    <p hidden role="status" data-list-filter-target="empty" class="px-4 py-12 text-center text-ink-soft">Nenhum item encontrado.</p>
    <%= render "list", groups: @groups %>
  </section>

  <nav aria-label="Telas" class="app-navigation fixed inset-x-0 bottom-0 z-20 border-t border-line bg-canvas/95 pb-[env(safe-area-inset-bottom)] backdrop-blur">
    <div class="desktop-brand hidden px-4 pb-6"><p class="flex items-center gap-2 text-2xl font-semibold tracking-tight"><%= render "brand_mark", css_class: "size-8 shrink-0" %>Alva</p><p class="mt-1 text-xs text-ink-faint">Nossa casa</p></div>
    <div class="navigation-items mx-auto grid max-w-md grid-cols-2 gap-1 px-3 py-1.5">
      <% [ [ "add", "nav_add", "Adicionar" ], [ "list", "nav_list", "Lista" ] ].each do |name, id, label| %>
        <%= tag.button type: "button", id: id,
              aria: { current: ("page" if screen == name) },
              data: { screen_target: "tab", screen_name: name, action: "screen#show", screen_screen_param: name },
              class: "flex items-center justify-center gap-2 rounded-xl py-2.5 text-sm font-medium text-ink-faint aria-[current=page]:bg-surface aria-[current=page]:text-ink" do %>
          <% if name == "add" %>
            <svg class="size-5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M10 4v12M4 10h12" /></svg>
            <%= label %>
          <% else %>
            <svg class="size-5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><path d="M7 5.5h9M7 10h9M7 14.5h9" /><circle cx="3.75" cy="5.5" r=".75" /><circle cx="3.75" cy="10" r=".75" /><circle cx="3.75" cy="14.5" r=".75" /></svg>
            <%= label %>
            <%= render "list_counter", groups: @groups %>
          <% end %>
        <% end %>
      <% end %>
    </div>
  </nav>
<% end %>

<%# Filled by turbo_stream.update in the response to a remove or "Compra feita"
    (see _toast); fixed above the bottom navigation. %>
<div id="toast" class="pointer-events-none fixed inset-x-0 bottom-0 z-30 mx-auto flex max-w-md justify-center px-4 pb-[calc(env(safe-area-inset-bottom)+4.75rem)]"></div>
