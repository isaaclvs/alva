<% purchased_count = groups.sum { |_, items| items.count(&:purchased?) } %>
<%= tag.div id: "list_finish", class: "list-finish pt-2 pb-4", hidden: purchased_count.zero? do %>
  <% if purchased_count.positive? %>
    <%= button_to "Compra feita", shopping_trips_path, form: { class: "contents" },
          aria: { describedby: "finish_shopping_hint" },
          class: "w-full rounded-2xl border border-accent bg-accent-soft py-3 text-base font-semibold text-accent-strong active:opacity-80" %>
    <p id="finish_shopping_hint" class="mt-2 text-center text-xs text-ink-faint">
      Arquiva <%= pluralize(purchased_count, "item comprado", plural: "itens comprados") %>; pendentes continuam na lista.
    </p>
  <% end %>
<% end %>
