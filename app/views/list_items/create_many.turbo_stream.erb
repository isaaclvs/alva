<%= render "refresh", groups: @groups, suggestions: @suggestions, household: current_household %>
<%= turbo_stream.replace "list_item_form", partial: "form", locals: { list_item: ListItem.new } %>
<%= @feedback %>
<%= turbo_stream.prepend "recent_adds_list", partial: "recent_item", collection: @results.select { |result| result.outcome.in?(%i[created revived]) }.map(&:item).reverse.first(3), as: :item %>
<% @results.each do |result| %>
  <%= turbo_stream.replace result.item, partial: "list_item", locals: { list_item: result.item, highlight: true } %>
<% end %>
