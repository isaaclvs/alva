<%= tag.li id: dom_id(list_item), class: class_names("animate-highlight": local_assigns[:highlight]) do %>
  <%= button_to toggle_list_item_path(list_item), method: :patch,
        aria: { pressed: list_item.purchased? },
        class: "flex w-full items-center gap-3 px-3 py-3 text-left" do %>
    <span class="<%= class_names("flex size-5 shrink-0 items-center justify-center rounded border-2",
                     "border-teal-700 bg-teal-700 text-white": list_item.purchased?,
                     "border-stone-400": list_item.pending?) %>" aria-hidden="true">
      <% if list_item.purchased? %>✓<% end %>
    </span>
    <span class="<%= class_names("text-base", "text-stone-400 line-through": list_item.purchased?) %>"><%= list_item.name %></span>
  <% end %>
<% end %>
