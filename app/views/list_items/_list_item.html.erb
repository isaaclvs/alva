<%= tag.li id: dom_id(list_item), data: { search_name: TextNormalizer.plain(list_item.name), purchased: list_item.purchased? }, class: class_names("flex items-center", "animate-highlight": local_assigns[:highlight] || list_item.just_listed?) do %>
  <%= turbo_frame_tag dom_id(list_item, :row), class: "flex min-w-0 flex-1 items-center" do %>
    <%= render "list_items/row", list_item: list_item %>
  <% end %>
<% end %>
