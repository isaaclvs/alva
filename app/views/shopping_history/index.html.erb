<% content_for :title, "Compras · Alva" %>

<%# Read-only: what "Compra feita" archived, one month per page. The only action
    is "Adicionar tudo de novo" on a trip, which goes through the same add path
    as the field on Adicionar. %>
<div>
  <header class="sticky top-0 z-10 bg-canvas px-4 pt-5 pb-3">
    <div class="flex items-center gap-2.5">
      <%= link_to root_path, title: "Voltar para a lista", aria: { label: "Voltar para a lista" },
            class: "grid size-touch shrink-0 place-items-center rounded-full text-ink-soft active:bg-surface-2 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent" do %>
        <svg class="size-icon-bar" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="var(--stroke-icon)" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 4 6 10l6 6" />
        </svg>
      <% end %>
      <div class="leading-tight">
        <h1 class="text-title font-semibold">Compras</h1>
        <p class="mt-0.5 text-xs text-ink-faint">O que já foi comprado, por mês.</p>
      </div>
    </div>

    <%# One page per month: the month in the middle, the ones beside it as the
        page before and after. Months without a trip have no page. %>
    <% if @page.month %>
      <nav aria-label="Meses" class="mt-4 flex items-center justify-between gap-2">
        <% if @page.older_month %>
          <%= link_to "Mês anterior", shopping_history_path(month: @page.older_month.key),
                class: "flex min-h-[var(--size-touch)] items-center rounded-control px-3 text-sm font-medium text-accent-strong active:bg-surface-2" %>
        <% else %>
          <span class="min-h-[var(--size-touch)] px-3" aria-hidden="true"></span>
        <% end %>
        <p id="history_month" class="text-sm font-semibold text-ink"><%= history_month_label(@page.month) %></p>
        <% if @page.newer_month %>
          <%= link_to "Próximo mês", shopping_history_path(month: @page.newer_month.key),
                class: "flex min-h-[var(--size-touch)] items-center rounded-control px-3 text-sm font-medium text-accent-strong active:bg-surface-2" %>
        <% else %>
          <span class="min-h-[var(--size-touch)] px-3" aria-hidden="true"></span>
        <% end %>
      </nav>
    <% end %>
  </header>

  <div id="history_feedback" role="status" aria-live="polite" class="min-h-5 px-5 text-sm font-medium"></div>

  <div class="px-4 pb-24">
    <% if @page.empty? %>
      <div class="py-16 text-center" id="history_empty">
        <p class="text-4xl" aria-hidden="true">🧾</p>
        <p class="mt-3 text-ink-soft">Nenhuma compra registrada ainda.</p>
        <p class="mt-1 text-sm text-ink-faint">Ao tocar em Compra feita, o que foi comprado aparece aqui.</p>
        <%= link_to "Voltar para a lista", root_path,
              class: "mt-4 inline-flex min-h-[var(--size-touch)] items-center text-sm font-semibold text-accent-strong underline underline-offset-4" %>
      </div>
    <% else %>
      <ul class="space-y-3">
        <% @page.trips.each do |entry| %>
          <%# Expansível: the summary is the date and the size; the items by
              category and the one action are inside. Closed by default so the
              month stays a short list of days. %>
          <li>
            <details class="overflow-hidden rounded-card border border-line bg-surface" data-history-trip="<%= entry.trip.public_id %>">
              <summary class="flex min-h-[var(--size-touch)] cursor-pointer list-none items-center gap-3 px-4 py-3 active:bg-surface-2">
                <span class="min-w-0 flex-1">
                  <span class="block text-base font-medium text-ink"><%= history_trip_label(entry.trip) %></span>
                  <span class="mt-0.5 block text-xs text-ink-faint"><%= history_items_label(entry.items_count) %></span>
                </span>
                <svg class="size-icon-inline shrink-0 text-ink-faint transition-transform" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="var(--stroke-icon)" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="m4 6 4 4 4-4" />
                </svg>
              </summary>

              <div class="border-t border-line">
                <% entry.groups.each do |category, items| %>
                  <section class="px-4 pt-3 pb-1">
                    <h3 class="mb-1.5 flex items-center gap-2 text-sm font-semibold text-ink-soft">
                      <%= category_icon(category) %>
                      <%= Category.label_for(category) %>
                      <span class="ml-auto text-xs font-medium text-ink-faint tabular-nums"><%= items.size %></span>
                    </h3>
                    <ul class="divide-y divide-line">
                      <% items.each do |item| %>
                        <li class="py-2 text-base text-ink"><%= item.name %></li>
                      <% end %>
                    </ul>
                  </section>
                <% end %>

                <%= button_to shopping_history_add_all_path(entry.trip), method: :post,
                      form: { class: "p-4 pt-3" },
                      class: "flex min-h-[var(--size-touch)] w-full items-center justify-center gap-2 rounded-control bg-accent-soft px-4 text-sm font-semibold text-accent-strong active:opacity-80" do %>
                  <svg class="size-icon-bar" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="var(--stroke-icon)" stroke-linecap="round" aria-hidden="true">
                    <path d="M10 4v12M4 10h12" />
                  </svg>
                  Adicionar tudo de novo
                <% end %>
              </div>
            </details>
          </li>
        <% end %>
      </ul>
    <% end %>
  </div>
</div>
