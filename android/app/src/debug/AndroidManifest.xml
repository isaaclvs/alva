<?xml version="1.0" encoding="utf-8"?>
<!--
    Development-only manifest overlay.

    The debug build is the native Compose entry point used to build the offline
    client. The Trusted Web Activity stays in the production (release) build; in
    debug its launcher is disabled so there is a single launcher icon.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:dataExtractionRules="@xml/alva_data_extraction_rules"
        android:fullBackupContent="@xml/alva_backup_rules"
        android:networkSecurityConfig="@xml/alva_network_security_config">
        <activity
            android:name="LauncherActivity"
            android:enabled="false"
            tools:replace="android:enabled" />

        <activity
            android:name="MainActivity"
            android:windowSoftInputMode="adjustResize"
            android:exported="true"
            android:label="@string/launcherName"
            android:theme="@style/Theme.AlvaDev">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <receiver android:name=".widgets.ShoppingListWidgetProvider" android:exported="false" android:label="Lista de compras">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/shopping_list_widget_info" />
        </receiver>
        <service android:name=".widgets.ShoppingListWidgetService" android:permission="android.permission.BIND_REMOTEVIEWS" android:exported="false" />
        <activity android:name=".widgets.WidgetListActionActivity" android:exported="false" android:theme="@android:style/Theme.NoDisplay" android:excludeFromRecents="true" />
        <receiver android:name=".widgets.HabitualWidgetProvider" android:exported="false" android:label="Atalhos de casa">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/habitual_widget_info" />
        </receiver>
        <activity android:name=".widgets.HabitualWidgetConfigureActivity" android:exported="true" android:theme="@android:style/Theme.Material.Light.NoActionBar">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" /></intent-filter>
        </activity>
    </application>
</manifest>
