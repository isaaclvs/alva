<?xml version="1.0" encoding="utf-8"?>
<!--
    Development-only manifest overlay.

    The debug build is the native Compose entry point used to build the offline
    client. The Trusted Web Activity stays in the production (release) build; in
    debug its launcher is disabled so there is a single launcher icon.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:dataExtractionRules="@xml/alva_data_extraction_rules"
        android:fullBackupContent="@xml/alva_backup_rules"
        android:networkSecurityConfig="@xml/alva_network_security_config">
        <activity
            android:name="LauncherActivity"
            android:enabled="false"
            tools:replace="android:enabled" />

        <activity
            android:name="MainActivity"
            android:windowSoftInputMode="adjustResize"
            android:exported="true"
            android:label="@string/launcherName"
            android:theme="@style/Theme.AlvaDev">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name="QuickPanelActivity" android:exported="false" android:windowSoftInputMode="adjustResize|stateAlwaysVisible" android:theme="@style/QuickAddDialog" />
        <receiver android:name="QuickAddWidgetProvider" android:exported="true">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/quick_add_widget_info" />
        </receiver>
    </application>
</manifest>
