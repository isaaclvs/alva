<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup and device-transfer rules for Android 12+ (android:dataExtractionRules).
    Same policy as alva_backup_rules.xml: credentials never leave the device
    through cloud backup or device-to-device transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="no_backup/" />
        <exclude domain="sharedpref" path="alva_quick_add.xml" />
        <exclude domain="sharedpref" path="__androidx_security_crypto_encrypted_prefs__.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="no_backup/" />
        <exclude domain="sharedpref" path="alva_quick_add.xml" />
        <exclude domain="sharedpref" path="__androidx_security_crypto_encrypted_prefs__.xml" />
    </device-transfer>
</data-extraction-rules>
