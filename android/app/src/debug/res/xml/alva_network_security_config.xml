<?xml version="1.0" encoding="utf-8"?>
<!--
    Debug builds only. Cleartext is allowed to the device's own loopback so tests
    and a local Rails (adb reverse) can be reached. Every other host keeps the
    platform default: TLS only, system CAs. The release manifest has no such file.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
