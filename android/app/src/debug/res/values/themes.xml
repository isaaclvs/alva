<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The main theme is translucent because the TWA owns the splash screen.
         The native debug screen needs an opaque theme of its own. -->
    <style name="Theme.AlvaDev" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/devBackground</item>
        <item name="android:statusBarColor">@color/devBackground</item>
        <item name="android:navigationBarColor">@color/devBackground</item>
    </style>
</resources>
