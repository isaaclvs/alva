<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/habitual_widget_root" android:layout_width="match_parent" android:layout_height="match_parent">
<ImageView android:id="@+id/habitual_widget_background" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/quick_add_widget_bg" android:scaleType="fitXY" android:importantForAccessibility="no"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp">
 <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:gravity="center_vertical">
 <TextView android:id="@+id/habitual_widget_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/nunito_sans_bold" android:text="Cozinha" android:textSize="16sp" android:layout_weight="1" android:maxLines="1" android:ellipsize="end"/>
 <TextView android:id="@+id/habitual_widget_configure" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/nunito_sans_regular" android:text="⋯" android:textSize="24sp" android:minWidth="48dp" android:minHeight="40dp" android:gravity="center" android:contentDescription="Configurar atalhos"/>
 </LinearLayout>
 <LinearLayout android:id="@+id/habitual_widget_rows" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
 <TextView android:id="@+id/habitual_widget_message" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/nunito_sans_regular" android:text="" android:textSize="11sp" android:layout_marginTop="7dp" android:maxLines="2"/>
</LinearLayout></FrameLayout>
