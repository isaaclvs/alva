<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/habitual_widget_root" android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/habitual_widget_background" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/habitual_widget_background" android:scaleType="fitXY" android:importantForAccessibility="no" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="8dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <TextView android:id="@+id/habitual_widget_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Atalhos de casa" android:textColor="#FFFFFF" android:textStyle="bold" android:fontFamily="@font/nunito_sans_semibold" android:textSize="15sp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/habitual_widget_configure" android:layout_width="48dp" android:layout_height="48dp" android:text="⚙" android:gravity="center" android:fontFamily="@font/nunito_sans_regular" android:textSize="22sp" android:textColor="#FFFFFF" android:contentDescription="Configurar atalhos" />
    </LinearLayout>
    <TextView android:id="@+id/habitual_widget_message" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/nunito_sans_regular" android:textSize="12sp" android:textColor="#CCCCCC" android:maxLines="1" android:ellipsize="end" />
    <LinearLayout android:id="@+id/habitual_widget_rows" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" />
</LinearLayout>
</FrameLayout>
