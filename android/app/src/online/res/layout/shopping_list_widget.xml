<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_list_root" android:layout_width="match_parent" android:layout_height="match_parent">
<ImageView android:id="@+id/widget_list_background" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/quick_add_widget_bg" android:importantForAccessibility="no" />
<LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical">
        <TextView android:fontFamily="@font/nunito_sans_regular" android:id="@+id/widget_list_title" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical" android:text="Lista de compras" android:textSize="16sp" android:textStyle="bold" />
        <TextView android:fontFamily="@font/nunito_sans_regular" android:id="@+id/widget_list_refresh" android:layout_width="48dp" android:layout_height="48dp" android:gravity="center" android:text="↻" android:textSize="26sp" android:contentDescription="Atualizar lista" />
        <TextView android:fontFamily="@font/nunito_sans_regular" android:id="@+id/widget_list_add" android:layout_width="48dp" android:layout_height="48dp" android:gravity="center" android:text="+" android:textSize="26sp" android:contentDescription="Adicionar item" />
    </LinearLayout>
    <TextView android:fontFamily="@font/nunito_sans_regular" android:id="@+id/widget_list_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:paddingBottom="6dp" />
    <ListView android:id="@+id/widget_list_rows" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:divider="@null" />
    <TextView android:fontFamily="@font/nunito_sans_regular" android:id="@+id/widget_list_empty" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:text="Carregando lista…" android:textSize="15sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <TextView android:fontFamily="@font/nunito_sans_regular" android:id="@+id/widget_list_status" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textSize="12sp" android:maxLines="3" />
        <TextView android:fontFamily="@font/nunito_sans_regular" android:id="@+id/widget_list_undo" android:layout_width="wrap_content" android:layout_height="48dp" android:paddingHorizontal="8dp" android:gravity="center" android:text="Desfazer" android:textSize="14sp" android:visibility="gone" />
    </LinearLayout>
</LinearLayout></FrameLayout>
