#!/usr/bin/env bash
# Runs the Android command transport (Kotlin) against a REAL Rails server, in isolation.
#
#   script/android_rails_transport_check
#
# What it does, and only this:
#   1. RAILS_ENV=test with a throwaway SQLite file in a temp directory (DATABASE_URL), loaded
#      from db/schema.rb and test/fixtures. Never storage/*.sqlite3, never development or
#      production data, never a real household.
#   2. Issues sync / add_only / revoked credentials for the fixture household.
#   3. Starts `bin/rails server` bound to 127.0.0.1 on a free port.
#   4. Runs android's RailsCommandTransportTest and RailsSnapshotTransportTest (JVM) pointed at it
#      through the file named by ALVA_RAILS_HARNESS. The first also puts a proxy in front of Rails
#      that drops answers the server already committed, to prove "response lost after commit, retry
#      gets duplicate"; the second reads the real GET /api/v1/snapshot with the Kotlin client.
#   5. Fails if those test classes did not actually run (a skipped test proves nothing).
#
# The steps 1-3 live in script/lib/android_rails_harness.sh, shared with
# script/android_rails_sync_check (Room on an emulator, two devices, real Rails).
#
# Needs Ruby (the version in .ruby-version), JDK 21 and the Android SDK (ANDROID_HOME).
# Override the gradle invocation with GRADLE_CMD (default: ./gradlew --max-workers=2).
set -euo pipefail

source "$(dirname "${BASH_SOURCE[0]}")/lib/android_rails_harness.sh"
harness_up

echo "== running the Kotlin transport against it"
export ALVA_RAILS_HARNESS="$work/harness.json"
# Rails and gradle must not share the Rails-only environment of this script.
(
  cd android
  unset RAILS_ENV DATABASE_URL ALVA_PASSWORD_DIGEST
  # --rerun: the harness file is not a Gradle input, so a cached pass would prove nothing.
  ${GRADLE_CMD:-./gradlew --max-workers=2} --console=plain testDebugUnitTest \
    --tests 'net.ts.taild80ca0.atlas.twa.sync.RailsCommandTransportTest' \
    --tests 'net.ts.taild80ca0.atlas.twa.sync.RailsSnapshotTransportTest' --rerun
)

for name in RailsCommandTransportTest RailsSnapshotTransportTest; do
  harness_require_run "android/app/build/test-results/testDebugUnitTest/TEST-net.ts.taild80ca0.atlas.twa.sync.$name.xml" "$name"
done
echo "== OK: the Kotlin transport and snapshot client ran against real Rails"
