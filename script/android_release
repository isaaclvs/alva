#!/usr/bin/env bash
# Builds the Alva release APK from the online variant and prepares the artifacts
# the download page serves (/downloads). A manual release used to depend on the
# memory of whoever was building it; this script owns the repeatable part.
#
#   script/android_release            # real release
#   script/android_release --dry-run  # validates everything it can, signs nothing
#
# Signing material is never read from the repository: the keystore path, the key
# alias and the two passwords come from the environment or from a file whose path
# is given in a *_FILE variable. Nothing secret is ever echoed, and this script
# never enables `set -x`. See docs/deployment/android-apk.md.
#
# Environment (a real release needs all four signing variables):
#   ALVA_ANDROID_KEYSTORE             keystore file, outside the repository
#   ALVA_ANDROID_KEY_ALIAS            alias of the release key
#   ALVA_ANDROID_STORE_PASSWORD       keystore password
#   ALVA_ANDROID_KEY_PASSWORD         key password
#   ALVA_ANDROID_STORE_PASSWORD_FILE  file with the keystore password (one line)
#   ALVA_ANDROID_KEY_PASSWORD_FILE    file with the key password (one line)
#   ALVA_RELEASE_DIR                  output directory (default: public/downloads)
#   ALVA_RELEASE_LATEST_JSON          last published latest.json
#                                     (default: $ALVA_RELEASE_DIR/latest.json)
#   ALVA_APKSIGNER                    apksigner binary (default: newest in the SDK)
set -euo pipefail

root_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
android_dir="$root_dir/android"
gradle_config="$android_dir/app/build.gradle"
built_apk="$android_dir/app/build/outputs/apk/release/app-release.apk"

dry_run=false

step() { printf '\n== %s\n' "$*"; }
ok() { printf '   ok    %s\n' "$*"; }
note() { printf '   ..    %s\n' "$*"; }
warn() { printf '   warn  %s\n' "$*" >&2; }
die() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

usage() {
  cat <<'USAGE'
Usage: script/android_release [--dry-run]

  --dry-run   validate the configuration, the tooling and the signing material
              without building, signing or writing any artifact
  -h, --help  show this help

Signing material comes from the environment: ALVA_ANDROID_KEYSTORE,
ALVA_ANDROID_KEY_ALIAS, ALVA_ANDROID_STORE_PASSWORD and
ALVA_ANDROID_KEY_PASSWORD, or from the files named by
ALVA_ANDROID_STORE_PASSWORD_FILE and ALVA_ANDROID_KEY_PASSWORD_FILE.
USAGE
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run) dry_run=true ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      usage >&2
      die "unknown argument: $1"
      ;;
  esac
  shift
done

release_dir="${ALVA_RELEASE_DIR:-$root_dir/public/downloads}"
latest_json="${ALVA_RELEASE_LATEST_JSON:-$release_dir/latest.json}"
[[ $release_dir == /* ]] || release_dir="$root_dir/$release_dir"
[[ $latest_json == /* ]] || latest_json="$root_dir/$latest_json"

# Prints a secret from the environment, or the first line of the file named by
# its _FILE twin. Never call this where the result would be echoed.
secret_value() {
  local name="$1" file_var value=""
  file_var="${name}_FILE"
  if [[ -n ${!name:-} ]]; then
    value="${!name}"
  elif [[ -n ${!file_var:-} ]]; then
    if [[ ! -r ${!file_var} ]]; then
      printf 'error: %s points to a file that cannot be read\n' "$file_var" >&2
      return 1
    fi
    value="$(head -n 1 "${!file_var}")"
  fi
  printf '%s' "$value"
}

# Prints a build-tools binary: $override_env when set, then PATH, then the
# newest build-tools of the Android SDK. Prints nothing when there is none.
find_sdk_tool() {
  local override="$1" name="$2" sdk
  if [[ -n $override ]]; then
    printf '%s\n' "$override"
    return 0
  fi
  if command -v "$name" >/dev/null 2>&1; then
    command -v "$name"
    return 0
  fi
  sdk="${ANDROID_HOME:-${ANDROID_SDK_ROOT:-$HOME/Android/Sdk}}"
  find "$sdk/build-tools" -maxdepth 2 -name "$name" -type f 2>/dev/null | sort -V | tail -n 1 || true
}

# Prints the SHA-256 digest of a file as lowercase hex, using whichever of
# sha256sum/shasum the system has.
sha256_of() {
  local file="$1" digest
  if command -v sha256sum >/dev/null 2>&1; then
    digest="$(sha256sum "$file")"
  elif command -v shasum >/dev/null 2>&1; then
    digest="$(shasum -a 256 "$file")"
  else
    printf 'error: neither sha256sum nor shasum is available\n' >&2
    return 1
  fi
  printf '%s' "${digest%% *}"
}

# Prints the SHA-256 of the certificate of $alias in a keystore. The password
# reaches keytool through a 0600 temporary file instead of the command line,
# where every local user would see it in `ps`.
keystore_fingerprint() {
  local keystore="$1" alias="$2" password="$3" secret_file output
  command -v keytool >/dev/null 2>&1 || die "keytool (JDK) is not on PATH"
  secret_file="$(mktemp "${TMPDIR:-/tmp}/alva-keystore-pass.XXXXXX")"
  chmod 600 "$secret_file"
  printf '%s\n' "$password" >"$secret_file"
  if ! output="$(keytool -list -v -keystore "$keystore" -alias "$alias" \
    -storepass:file "$secret_file" 2>&1)"; then
    rm -f "$secret_file"
    die "keytool cannot read the keystore with that alias (wrong password or alias?)"
  fi
  rm -f "$secret_file"
  printf '%s\n' "$output" | sed -nE 's/^[[:space:]]*SHA256: (.*)$/\1/p' | head -n 1
}
# Proves the release output directory is usable without writing anything: an
# existing directory must be writable, and a missing one must be creatable from
# its nearest existing ancestor. A dry run never leaves the directory behind.
require_writable_release_dir() {
  local dir="$1" existing="$1"
  while [[ ! -e $existing ]]; do
    existing="$(dirname "$existing")"
    [[ $existing != / ]] || break
  done
  [[ -d $existing ]] || die "${existing#"$root_dir"/} is not a directory"
  [[ -w $existing ]] || die "${existing#"$root_dir"/} is not writable"
  [[ $dir == "$existing" ]] || note "would create ${dir#"$root_dir"/}"
}
read_version() {
  version_code="$(sed -nE 's/^[[:space:]]*versionCode[[:space:]]+([0-9]+).*/\1/p' "$gradle_config" | head -n 1)"
  version_name="$(sed -nE "s/^[[:space:]]*versionName[[:space:]]+['\"]([^'\"]+)['\"].*/\1/p" "$gradle_config" | head -n 1)"
  application_id="$(sed -nE "s/^[[:space:]]*applicationId[[:space:]]+['\"]([^'\"]+)['\"].*/\1/p" "$gradle_config" | head -n 1)"
}

# Uppercases a certificate digest and puts a colon between bytes, so the value
# apksigner prints and the value assetlinks.json pins compare equal.
normalize_fingerprint() {
  local compact
  compact="$(printf '%s' "$1" | tr -d ':[:space:]' | tr '[:lower:]' '[:upper:]')"
  [[ $compact =~ ^[0-9A-F]+$ && $(( ${#compact} % 2 )) -eq 0 ]] || return 1
  printf '%s' "$compact" | sed -E 's/(..)/\1:/g; s/:$//'
}

# Checks the signature of $1 against public/.well-known/assetlinks.json and
# aborts unless it is verifiable and signed by the pinned certificate.
verify_signature() {
  local apk="$1" output fingerprint
  output="$("$apksigner" verify --print-certs "$apk" 2>&1)" ||
    die "apksigner does not accept the signature of ${apk##*/}: $output"
  fingerprint="$(printf '%s\n' "$output" |
    sed -nE 's/^Signer #1 certificate SHA-256 digest: (.*)$/\1/p' | head -n 1)"
  [[ -n $fingerprint ]] || die "apksigner reported no signer certificate for ${apk##*/}"
  fingerprint="$(normalize_fingerprint "$fingerprint")" ||
    die "apksigner printed an unreadable SHA-256 digest"
  [[ $fingerprint == "$expected_fingerprint" ]] || die \
    "signature mismatch: the APK is signed by $fingerprint, assetlinks.json pins $expected_fingerprint"
  printf '%s' "$fingerprint"
}

step "reading the build configuration"
[[ -r $gradle_config ]] || die "missing ${gradle_config#"$root_dir"/}"
read_version
[[ -n $application_id ]] || die "no applicationId in ${gradle_config#"$root_dir"/}"
[[ $version_code =~ ^[0-9]+$ ]] || die "no versionCode in ${gradle_config#"$root_dir"/}"
[[ $version_name =~ ^[0-9]+(\.[0-9]+)*$ ]] || die "no versionName in ${gradle_config#"$root_dir"/}"
ok "versionName $version_name, versionCode $version_code"
ok "applicationId $application_id"
ok "artifacts go to ${release_dir#"$root_dir"/}"

step "reading the signing material"
keystore="$(secret_value ALVA_ANDROID_KEYSTORE)"
key_alias="$(secret_value ALVA_ANDROID_KEY_ALIAS)"
store_password="$(secret_value ALVA_ANDROID_STORE_PASSWORD)"
key_password="$(secret_value ALVA_ANDROID_KEY_PASSWORD)"

missing_signing=()
[[ -n $keystore ]] || missing_signing+=(ALVA_ANDROID_KEYSTORE)
[[ -n $key_alias ]] || missing_signing+=(ALVA_ANDROID_KEY_ALIAS)
[[ -n $store_password ]] || missing_signing+=(ALVA_ANDROID_STORE_PASSWORD)
[[ -n $key_password ]] || missing_signing+=(ALVA_ANDROID_KEY_PASSWORD)
signing_ready=false
if [[ ${#missing_signing[@]} -eq 0 ]]; then
  signing_ready=true
  [[ -r $keystore ]] || die "ALVA_ANDROID_KEYSTORE points to an unreadable file: $keystore"
  keystore_dir="$(cd "$(dirname "$keystore")" && pwd)"
  case "$keystore_dir/$(basename "$keystore")" in
    "$root_dir"/*) die "the keystore must stay outside the repository: $keystore" ;;
  esac
  ok "signing with alias $key_alias, keystore outside the repository"
else
  warn "signing material not configured (missing ${missing_signing[*]})"
fi

step "checking the tooling"
command -v java >/dev/null 2>&1 || die "java (JDK 21) is not on PATH"
[[ -x $android_dir/gradlew ]] || die "missing android/gradlew"
apksigner="$(find_sdk_tool "${ALVA_APKSIGNER:-}" apksigner)"
[[ -n $apksigner && -x $apksigner ]] ||
  die "apksigner not found; set ALVA_APKSIGNER or ANDROID_HOME"
ok "java $(java -version 2>&1 | head -n 1 | sed -E 's/^(openjdk|java) version "?([^" ]+)"?.*/\2/')"
ok "apksigner ${apksigner#"$HOME"/}"

step "reading the published app links"
assetlinks="$root_dir/public/.well-known/assetlinks.json"
[[ -r $assetlinks ]] || die "missing public/.well-known/assetlinks.json"
command -v ruby >/dev/null 2>&1 || die "ruby is needed to read public/.well-known/assetlinks.json"
expected_fingerprint="$(
  ruby -rjson -e '
    package = ARGV[0]
    targets = JSON.parse(File.read(ARGV[1])).flat_map do |entry|
      target = entry["target"]
      target.is_a?(Array) ? target : [target]
    end
    target = targets.compact.find do |t|
      t["namespace"] == "android_app" && t["package_name"] == package
    end
    exit 1 unless target
    fingerprint = Array(target["sha256_cert_fingerprints"]).first
    exit 1 unless fingerprint
    print fingerprint
  ' "$application_id" "$assetlinks"
)" || die "no SHA-256 fingerprint for $application_id in public/.well-known/assetlinks.json"
expected_fingerprint="$(normalize_fingerprint "$expected_fingerprint")" ||
  die "public/.well-known/assetlinks.json pins an unreadable SHA-256 fingerprint"
ok "assetlinks.json pins ${expected_fingerprint:0:14}… for $application_id"

step "checking the published version"
published_code=""
published_name=""
if [[ -r $latest_json ]]; then
  published="$(ruby -rjson -e '
    data = JSON.parse(File.read(ARGV[0]))
    print "#{data["versionCode"]}\t#{data["versionName"]}"
  ' "$latest_json")" || die "${latest_json#"$root_dir"/} is not valid JSON"
  published_code="${published%%$'\t'*}"
  published_name="${published#*$'\t'}"
  [[ $published_code =~ ^[0-9]+$ ]] ||
    die "${latest_json#"$root_dir"/} has no numeric versionCode"
  ok "last published ${published_name:-?} (versionCode $published_code)"
elif [[ -d $release_dir && -n "$(find "$release_dir" -maxdepth 1 -name 'Alva-*.apk' -print -quit)" ]]; then
  die "${latest_json#"$root_dir"/} is missing, but $release_dir already holds an APK; refusing to publish over it without knowing its versionCode (pass ALVA_RELEASE_LATEST_JSON)"
else
  note "no published release yet, nothing to compare against"
fi

if [[ -n $published_code ]] && ((version_code <= published_code)); then
  die "versionCode $version_code is not newer than the published $published_code; bump versionCode and versionName in ${gradle_config#"$root_dir"/} before releasing"
fi

if [[ $signing_ready == true ]]; then
  step "checking the release key"
  keystore_cert="$(keystore_fingerprint "$keystore" "$key_alias" "$store_password")"
  keystore_cert="$(normalize_fingerprint "$keystore_cert")" ||
    die "keytool printed no SHA256 fingerprint for alias $key_alias"
  [[ $keystore_cert == "$expected_fingerprint" ]] || die \
    "the key in the keystore is ${keystore_cert:0:14}…, but assetlinks.json pins ${expected_fingerprint:0:14}…; a build signed with it would stop updating the installed app"
  ok "the keystore holds the certificate assetlinks.json pins"
fi

if [[ $dry_run == true ]]; then
  step "dry run"
  if [[ $signing_ready == true ]]; then
    note "would sign with alias $key_alias"
  else
    warn "a real run stops before building until the signing material is configured"
  fi
  require_writable_release_dir "$release_dir"
  note "would run: (cd android && ./gradlew assembleRelease)"
  note "would check that the APK declares $application_id $version_name (versionCode $version_code)"
  note "would write ${release_dir#"$root_dir"/}/Alva-$version_name.apk, .sha256 and $(basename "$latest_json")"
  note "nothing was built, signed or written"
  exit 0
fi

[[ $signing_ready == true ]] || die "a real release needs the signing material; see the header"

step "building the release APK"
# A build left by an earlier run must never be mistaken for this one.
rm -f "$built_apk"
(
  cd "$android_dir"
  ./gradlew assembleRelease
)
[[ -f $built_apk ]] || die "gradle finished without $built_apk; is the signing config in place?"
ok "built ${built_apk#"$root_dir"/}"

step "verifying the signature"
signed_fingerprint="$(verify_signature "$built_apk")"
ok "apksigner verify passed, certificate ${signed_fingerprint:0:14}… matches assetlinks.json"

step "publishing the artifacts"
aapt="$(find_sdk_tool "${ALVA_AAPT:-}" aapt)"
[[ -n $aapt && -x $aapt ]] || die "aapt not found; set ALVA_AAPT or ANDROID_HOME"
badging="$("$aapt" dump badging "$built_apk" 2>/dev/null)" ||
  die "aapt cannot read ${built_apk##*/}"
built_package="$(printf '%s\n' "$badging" | sed -nE "s/^package: name='([^']+)'.*/\1/p")"
built_code="$(printf '%s\n' "$badging" | sed -nE "s/^package:.* versionCode='([0-9]+)'.*/\1/p")"
built_name="$(printf '%s\n' "$badging" | sed -nE "s/^package:.* versionName='([^']+)'.*/\1/p")"
[[ $built_package == "$application_id" ]] ||
  die "the APK declares package $built_package, expected $application_id"
[[ $built_code == "$version_code" && $built_name == "$version_name" ]] || die \
  "the APK declares $built_name (versionCode $built_code), but $gradle_config says $version_name (versionCode $version_code)"
ok "the APK declares $built_package $built_name (versionCode $built_code)"

mkdir -p "$release_dir"
published_apk="$release_dir/Alva-$version_name.apk"
checksum_file="$published_apk.sha256"
apk_sha256="$(sha256_of "$built_apk")"
[[ $apk_sha256 =~ ^[0-9a-f]{64}$ ]] || die "cannot compute the SHA-256 of ${built_apk##*/}"

temporary_latest="$(mktemp "$release_dir/.latest.json.XXXXXX")"
published_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
ruby -rjson -e '
  print JSON.pretty_generate(
    "versionName" => ARGV[0],
    "versionCode" => Integer(ARGV[1]),
    "sha256" => ARGV[2],
    "publishedAt" => ARGV[3]
  ), "\n"
' "$version_name" "$version_code" "$apk_sha256" "$published_at" >"$temporary_latest"

# The files are served by the Rails process, so they are world-readable like any
# other file under public/; mktemp starts at 0600.
chmod 0644 "$temporary_latest"
printf '%s  %s\n' "$apk_sha256" "$(basename "$published_apk")" >"$checksum_file.tmp"
chmod 0644 "$checksum_file.tmp"
mv "$checksum_file.tmp" "$checksum_file"
cp "$built_apk" "$published_apk.tmp"
chmod 0644 "$published_apk.tmp"
# The APK lands last: a half-written artifact never sits under the name the
# download page points at, and latest.json only moves forward once the files it
# describes are already there.
mv "$published_apk.tmp" "$published_apk"
mv "$temporary_latest" "$latest_json"

ok "APK      ${published_apk#"$root_dir"/}"
ok "checksum ${checksum_file#"$root_dir"/}"
ok "release  ${latest_json#"$root_dir"/} ($version_name, versionCode $version_code)"
printf '\nSHA-256: %s\n' "$apk_sha256"
note "install over the previous app, never uninstalling it: adb install -r \"$published_apk\""
note "publishing is local only; nothing was uploaded"

